<Window x:Class="BPet.ChatDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPet Chat" Width="640" Height="168" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
  <Border Background="#F8F7FCF8" CornerRadius="18" BorderBrush="#D9D2F2" BorderThickness="1" Padding="12,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Log" TextWrapping="Wrap" Foreground="#2C2740" FontSize="13" LineHeight="18"/>
      </ScrollViewer>
      <DockPanel Grid.Row="1" Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="Gửi" Click="Send_Click" Margin="8,0,0,0" Padding="14,6"/>
        <Button DockPanel.Dock="Right" Content="Đóng" Click="Close_Click" Padding="10,6" Background="#827E96"/>
        <TextBox x:Name="Input" VerticalContentAlignment="Center" Padding="8,4" KeyDown="Input_KeyDown"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
