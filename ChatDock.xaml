<Window x:Class="BPet.ChatDock" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="BPet · Trợ lý của bạn" Width="420" Height="390" MinWidth="350" MinHeight="300" WindowStyle="SingleBorderWindow" Background="#F5F4FA" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#EBE7F7"/><Setter Property="Foreground" Value="#493B6F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#29213F" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PetTitle" Text="BPet" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ProviderLabel" Foreground="#C8BFDE" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Cài đặt" Click="Settings_Click" VerticalAlignment="Center" Background="#443656" Foreground="White"/></Grid></Border>
  <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,9"><StackPanel x:Name="Messages"/></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="12,3,12,7">
   <TextBlock x:Name="Status" Text="Sẵn sàng" Foreground="#746985" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <WrapPanel><Button Content="Các lệnh" Click="Help_Click"/><Button Content="Kết nối trình duyệt" Click="Browser_Click"/><Button x:Name="RetryButton" Content="Thử lại" Click="Retry_Click" Visibility="Collapsed"/><Button x:Name="CancelButton" Content="Dừng" Click="Cancel_Click" Visibility="Collapsed"/></WrapPanel>
  </StackPanel>
  <Border Grid.Row="3" Background="White" BorderBrush="#E3DEEE" BorderThickness="0,1,0,0" Padding="12,9"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="80" VerticalScrollBarVisibility="Auto" Padding="12,10" FontSize="14" Foreground="#30273E" Background="#F5F3FA" BorderThickness="0" PreviewKeyDown="Input_KeyDown"/>
   <Button x:Name="SendButton" Grid.Column="1" Content="Gửi" Click="Send_Click" Background="#7756D5" Foreground="White" Margin="10,0,0,0" Padding="19,12" VerticalAlignment="Bottom"/>
   <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Enter để gửi · Shift + Enter xuống dòng" FontSize="11" Foreground="#8A8097" Margin="2,9,0,0"/>
  </Grid></Border>
 </Grid>
</Window>
