<Window x:Class="BPet.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BPet · Cài đặt" Width="950" Height="650" WindowStartupLocation="CenterScreen" Background="#F7F6FC">
  <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#25213C" CornerRadius="18" Padding="14"><StackPanel><TextBlock Text="BPET" FontSize="24" FontWeight="Bold" Foreground="White" Margin="8,4,0,20"/>
      <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" Background="Transparent" Foreground="White" BorderThickness="0"><ListBoxItem Content="General" IsSelected="True"/><ListBoxItem Content="Character"/><ListBoxItem Content="AI Provider"/><ListBoxItem Content="AI Personality"/><ListBoxItem Content="Relationship"/><ListBoxItem Content="Pet Behavior"/><ListBoxItem Content="Việc hàng ngày"/><ListBoxItem Content="Báo tin"/><ListBoxItem Content="Memory"/><ListBoxItem Content="Advanced"/><ListBoxItem Content="About"/></ListBox>
    </StackPanel></Border>
    <Border Grid.Column="1" Margin="18,0,0,0" Background="White" CornerRadius="18" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="PageTitle" Text="General" FontSize="28" FontWeight="SemiBold" Foreground="#25213C" Margin="0,0,0,18"/>
      <StackPanel x:Name="GeneralPanel"><TextBlock Text="Ứng dụng" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="AlwaysOnTop" Content="Luôn hiển thị trên cùng" Margin="0,14,0,6"/><CheckBox x:Name="ClickThrough" Content="Click through (bỏ qua thao tác chuột)" Margin="0,6"/><CheckBox x:Name="LaunchWithWindows" Content="Khởi động cùng Windows" Margin="0,6"/><TextBlock Text="Ngôn ngữ" Margin="0,18,0,6"/><ComboBox x:Name="LanguagePicker" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Tiếng Việt"/><ComboBoxItem Content="English"/></ComboBox></StackPanel>
      <StackPanel x:Name="CharacterPanel" Visibility="Collapsed"><TextBlock Text="Nhân vật đang dùng" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="Character" Width="390" HorizontalAlignment="Left" Margin="0,12,0,8" SelectionChanged="Character_SelectionChanged" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal"><Button Content="Nhập character ZIP" Click="ImportZip_Click"/><Button Content="Nhập thư mục character" Click="ImportFolder_Click"/></StackPanel><TextBlock Text="Mỗi pack cần manifest.json; có thể chứa preview.png và tệp animation. Nếu thiếu animation của một trạng thái, BPet tự quay về Idle an toàn." TextWrapping="Wrap" Foreground="#5A5870" Margin="0,8,0,0"/></StackPanel>
      <StackPanel x:Name="AiPanel" Visibility="Collapsed"><TextBlock Text="Nhà cung cấp AI" FontSize="18" FontWeight="SemiBold"/><ComboBox x:Name="Provider" Width="250" HorizontalAlignment="Left" Margin="0,12,0,4" SelectionChanged="Provider_SelectionChanged"><ComboBoxItem Content="Không dùng AI"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Google Gemini"/><ComboBoxItem Content="OpenAI-compatible"/></ComboBox><TextBlock Text="API key (được mã hóa DPAPI trong Windows)" Margin="0,16,0,6"/><PasswordBox x:Name="ApiKey" Width="430" HorizontalAlignment="Left"/><TextBlock Text="Model" Margin="0,16,0,6"/><TextBox x:Name="Model" Width="430" HorizontalAlignment="Left"/><TextBlock Text="Custom API base URL (chỉ OpenAI-compatible)" Margin="0,16,0,6"/><TextBox x:Name="BaseUrl" Width="430" HorizontalAlignment="Left"/><CheckBox x:Name="Streaming" Content="Ưu tiên phản hồi streaming" Margin="0,14,0,0"/><Button Content="Kiểm tra kết nối" HorizontalAlignment="Left" Click="TestConnection_Click"/><TextBlock x:Name="ConnectionStatus" Foreground="#5A5870" Margin="4,8"/></StackPanel>
      <StackPanel x:Name="PersonalityPanel" Visibility="Collapsed"><TextBlock Text="Tính cách AI" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,12,0,4"><ComboBox x:Name="ProfilePicker" Width="220" SelectionChanged="ProfilePicker_SelectionChanged" DisplayMemberPath="Name"/><TextBox x:Name="ProfileName" Width="160" Margin="8,0" VerticalContentAlignment="Center" ToolTip="Tên profile"/><Button Content="Lưu profile" Click="SaveProfile_Click"/></StackPanel><TextBlock Text="Tên thú cưng" Margin="0,12,0,5"/><TextBox x:Name="PetName" Width="320" HorizontalAlignment="Left"/><TextBlock Text="Thái độ" Margin="0,14,0,5"/><ComboBox x:Name="Attitude" Width="320" HorizontalAlignment="Left"><ComboBoxItem Content="Cute"/><ComboBoxItem Content="Gentle"/><ComboBoxItem Content="Friendly"/><ComboBoxItem Content="Funny"/><ComboBoxItem Content="Energetic"/><ComboBoxItem Content="Calm"/><ComboBoxItem Content="Professional"/><ComboBoxItem Content="Serious"/><ComboBoxItem Content="Tsundere"/><ComboBoxItem Content="Caring"/><ComboBoxItem Content="Romantic"/><ComboBoxItem Content="Custom"/></ComboBox><TextBlock Text="Affection" Margin="0,16,0,2"/><Slider x:Name="Affection" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Humor" Margin="0,10,0,2"/><Slider x:Name="Humor" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Formality" Margin="0,10,0,2"/><Slider x:Name="Formality" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Talkativeness" Margin="0,10,0,2"/><Slider x:Name="Talkativeness" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Proactiveness" Margin="0,10,0,2"/><Slider x:Name="Proactiveness" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Emoji usage" Margin="0,10,0,2"/><Slider x:Name="EmojiUsage" Maximum="100" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Chỉ dẫn tùy chỉnh" Margin="0,12,0,5"/><TextBox x:Name="CustomInstructions" Width="520" Height="90" AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="RelationshipPanel" Visibility="Collapsed"><TextBlock Text="Relationship &amp; Speaking Style" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Chế độ chỉ điều chỉnh xưng hô và giọng điệu—không thay đổi quyền hay an toàn." Foreground="#5A5870" TextWrapping="Wrap" Margin="0,7,0,16"/><TextBlock Text="Preset"/><ComboBox x:Name="RelationshipPreset" Width="300" HorizontalAlignment="Left" SelectionChanged="RelationshipPreset_SelectionChanged"><ComboBoxItem Content="Trợ lý"/><ComboBoxItem Content="Bạn bè"/><ComboBoxItem Content="Dễ thương"/><ComboBoxItem Content="Anh - Em"/><ComboBoxItem Content="Em - Anh"/><ComboBoxItem Content="Chồng - Vợ"/><ComboBoxItem Content="Vợ - Chồng"/><ComboBoxItem Content="Tôi - Bạn"/><ComboBoxItem Content="Mình - Bạn"/><ComboBoxItem Content="Sếp - Trợ lý"/><ComboBoxItem Content="Custom"/></ComboBox><UniformGrid Columns="2" Margin="0,16,0,0"><StackPanel Margin="0,0,12,0"><TextBlock Text="BPet tự xưng"/><TextBox x:Name="PetPronoun"/></StackPanel><StackPanel><TextBlock Text="BPet gọi người dùng"/><TextBox x:Name="UserPronoun"/></StackPanel></UniformGrid><TextBlock Text="Tên người dùng" Margin="0,14,0,5"/><TextBox x:Name="UserName" Width="300" HorizontalAlignment="Left"/><TextBlock Text="Mô tả mối quan hệ" Margin="0,14,0,5"/><TextBox x:Name="RelationshipDescription" Width="420" HorizontalAlignment="Left"/><Button Content="Preview Conversation" Click="Preview_Click" HorizontalAlignment="Left"/><Border Background="#F1EEFF" CornerRadius="12" Padding="14" Margin="0,8,0,0"><TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#30285B"/></Border></StackPanel>
      <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed"><TextBlock Text="Hành vi thú cưng" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="AutoMovement" Content="Cho phép BPet tự di chuyển nhẹ nhàng" Margin="0,14,0,6"/><CheckBox x:Name="Simulation" Content="Bật mô phỏng chỉ số cảm xúc" Margin="0,6"/><TextBlock Text="Phong cách" Margin="0,16,0,4"/><ComboBox x:Name="PetStyle" Width="220" HorizontalAlignment="Left" SelectionChanged="PetStyle_SelectionChanged"><ComboBoxItem Content="Thường"/><ComboBoxItem Content="Kiếm hiệp"/><ComboBoxItem Content="Giang hồ"/></ComboBox><TextBlock Text="Kiếm hiệp ra đường chém, Giang hồ ra chưởng. Chuột phải pet rồi chọn Ra chiêu để xem ngay." Foreground="#5A5870" TextWrapping="Wrap" Margin="0,6,0,0" Width="460" HorizontalAlignment="Left"/><TextBlock Text="Kích thước pet" Margin="0,16,0,4"/><DockPanel Width="420" HorizontalAlignment="Left"><TextBlock x:Name="SizeLabel" DockPanel.Dock="Right" Width="52" VerticalAlignment="Center" Text="48%"/><Slider x:Name="PetSize" Minimum="35" Maximum="140" Value="48" ValueChanged="PetSize_ValueChanged" PreviewMouseLeftButtonUp="PetSize_Save"/></DockPanel><TextBlock Text="Tần suất tự động di chuyển" Margin="0,16,0,4"/><Slider x:Name="MovementFrequency" Maximum="100" Width="420" HorizontalAlignment="Left"/></StackPanel>
      <StackPanel x:Name="TasksPanel" Visibility="Collapsed"><TextBlock Text="Việc hàng ngày" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Đến đúng giờ, BPet mở thanh chat và soạn giúp. BPet không tự gửi tin nhắn và không tự nộp báo cáo." TextWrapping="Wrap" Foreground="#5A5870" Margin="0,8,0,12" Width="520" HorizontalAlignment="Left"/><ListBox x:Name="TaskList" Height="160" Width="520" HorizontalAlignment="Left"/><TextBlock Text="Tên việc" Margin="0,12,0,4"/><TextBox x:Name="TaskName" Width="420" HorizontalAlignment="Left"/><TextBlock Text="Loại" Margin="0,10,0,4"/><ComboBox x:Name="TaskKind" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Rep tin nhắn" Tag="reply"/><ComboBoxItem Content="Điền báo cáo" Tag="report"/><ComboBoxItem Content="Việc khác" Tag="custom"/></ComboBox><TextBlock Text="Giờ và phút" Margin="0,10,0,4"/><StackPanel Orientation="Horizontal"><TextBox x:Name="TaskHour" Width="64" Text="9"/><TextBlock Text=":" Margin="8,0" VerticalAlignment="Center"/><TextBox x:Name="TaskMinute" Width="64" Text="0"/></StackPanel><TextBlock Text="Ghi chú cho AI (kênh nào, mẫu báo cáo, giọng)" Margin="0,10,0,4"/><TextBox x:Name="TaskNote" Width="520" Height="72" AcceptsReturn="True" TextWrapping="Wrap" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Thêm việc" Click="AddTask_Click"/><Button Content="Xóa việc đang chọn" Click="RemoveTask_Click" Margin="8,0,0,0"/></StackPanel></StackPanel>
      <StackPanel x:Name="NewsPanel" Visibility="Collapsed"><TextBlock Text="Báo tin" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Tin hiện trên bong bóng phía trên đầu pet. Mỗi lần một mục, xoay vòng các mục đang bật." TextWrapping="Wrap" Foreground="#5A5870" Margin="0,8,0,12" Width="520" HorizontalAlignment="Left"/><CheckBox x:Name="NewsEnabled" Content="Bật báo tin" Margin="0,4"/><CheckBox x:Name="NewsGold" Content="Giá vàng" Margin="0,6"/><CheckBox x:Name="NewsAi" Content="Tin tức công nghệ AI" Margin="0,6"/><CheckBox x:Name="NewsMkt" Content="Marketing" Margin="0,6"/><TextBlock Text="Khoảng cách giữa hai lần báo" Margin="0,16,0,4"/><DockPanel Width="420" HorizontalAlignment="Left"><TextBlock x:Name="NewsIntervalLabel" DockPanel.Dock="Right" Width="70" VerticalAlignment="Center" Text="30 phút"/><Slider x:Name="NewsInterval" Minimum="10" Maximum="180" Value="30" ValueChanged="NewsInterval_Changed"/></DockPanel><Button Content="Báo ngay" HorizontalAlignment="Left" Margin="0,12,0,0" Click="NewsNow_Click"/></StackPanel>
      <StackPanel x:Name="InfoPanel" Visibility="Collapsed"><TextBlock x:Name="InfoText" FontSize="16" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0"><Button Content="Reset" Click="Reset_Click" Background="#827E96"/><Button Content="Lưu thay đổi" Click="Save_Click"/></StackPanel>
    </StackPanel></ScrollViewer></Border>
  </Grid>
</Window>
