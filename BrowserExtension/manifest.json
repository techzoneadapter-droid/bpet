{
  "manifest_version": 3,
  "name": "BPet — Nhớ phiên trình duyệt",
  "version": "1.0.0",
  "description": "Lưu tab và cửa sổ trên máy để BPet mở lại theo ngày. Không lưu tab ẩn danh.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BPet — Lưu phiên ngay"
  },
  "incognito": "not_allowed"
}