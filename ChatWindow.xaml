<Window x:Class="BPet.ChatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BPet Chat" Width="470" Height="620" WindowStartupLocation="CenterScreen" Background="#F7F6FC">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="BPet" FontSize="25" FontWeight="SemiBold" Foreground="#25213C"/><TextBlock x:Name="ProviderLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#625D7D"/></DockPanel>
  <ScrollViewer Grid.Row="1" Margin="0,15"><StackPanel x:Name="Messages"/></ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Gửi" Click="Send_Click"/><TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/></DockPanel>
 </Grid>
</Window>
