<Window x:Class="BPet.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="96" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
  <Border Background="#FFFFFFF6" CornerRadius="16" Padding="12,8" BorderBrush="#E4D8FF" BorderThickness="1">
    <TextBlock x:Name="Text" TextWrapping="Wrap" TextAlignment="Center" Foreground="#2C2740" FontSize="13" VerticalAlignment="Center"/>
  </Border>
</Window>
