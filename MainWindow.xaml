<Window x:Class="BPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BPet" Width="214" Height="260" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseLeftButtonUp="Pet_MouseLeftButtonUp" MouseMove="Pet_MouseMove" MouseRightButtonUp="Pet_MouseRightButtonUp" MouseDoubleClick="Pet_MouseDoubleClick">
  <Grid>
    <Border x:Name="SpeechBubble" Visibility="Collapsed" Background="#FDFDFFFF" CornerRadius="18" Padding="14" BorderBrush="#D8D1FF" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,0,154" Effect="{DynamicResource {x:Static SystemParameters.DropShadowKey}}">
      <TextBlock x:Name="SpeechText" TextWrapping="Wrap" Foreground="#26233B" FontSize="14" MaxHeight="78" />
    </Border>
    <Grid VerticalAlignment="Bottom" Height="175" x:Name="PetVisual">
      <Ellipse Fill="#8D72F8" Width="146" Height="146" VerticalAlignment="Bottom" />
      <Path Fill="#7055D6" Data="M37,43 L17,5 L68,27 Z" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="23,4,0,0" />
      <Path Fill="#7055D6" Data="M37,43 L17,5 L68,27 Z" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,23,0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform></Path>
      <Ellipse Fill="#FFFDFB" Width="27" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="49,59,0,0" />
      <Ellipse Fill="#FFFDFB" Width="27" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,59,49,0" />
      <Ellipse Fill="#25213C" Width="9" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,69,0,0" />
      <Ellipse Fill="#25213C" Width="9" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,69,58,0" />
      <Ellipse Fill="#F2A0B6" Width="16" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,95,0,0" />
      <TextBlock x:Name="StateText" Text="BPet · Idle" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
    </Grid>
  </Grid>
</Window>
